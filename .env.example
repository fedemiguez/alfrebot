# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon). Si falta, el MVP usa memoria local (alcanza para /probar).
DATABASE_URL=

# Vercel Blob. Si falta, las fotos usan /api/placeholder.
BLOB_READ_WRITE_TOKEN=

# Canal WhatsApp: meta | simulator
WA_PROVIDER=simulator

# Meta Cloud API (no hardcodear secretos)
META_TEST_MODE=true
META_BOT_NUMBER=15550000000
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# Números E.164 verificados en el número de prueba, separados por coma
META_VERIFIED_NUMBERS=

# IA opcional (AI Gateway). Sin esto el bot igual anda con parsers fijos.
AI_GATEWAY_API_KEY=
# Plan B
GOOGLE_GENERATIVE_AI_API_KEY=
