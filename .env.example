# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chat v2 (WhatsApp-like). Default ON. Set 0/false/off para servir v1 en /asistente.
# Rollback siempre disponible en /asistente-v1. Preview UI: /asistente-v2-preview
ALFREBOT_CHAT_V2=1

# Clerk (Marketplace en Vercel → preview/production). Local: vercel env pull o keys de Development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Post-login: evitar el default `/` de Clerk.
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/asistente
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/asistente
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/asistente
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/asistente

# Panel /admin — clave única. Sin esto, /admin muestra aviso y no permite entrar.
# En producción usá un valor largo y aleatorio; nunca lo hardcodees en el código.
ADMIN_SECRET=

# Database (Neon). Si falta, el MVP usa memoria local (alcanza para /asistente).
DATABASE_URL=

# Vercel Blob. Si falta, las fotos usan /api/placeholder.
BLOB_READ_WRITE_TOKEN=

# Opcional: Bearer para POST /api/upload desde server-side (nunca en el browser).
# El simulador en /asistente usa sesión Clerk; Meta/bot suben vía lib/blob sin este endpoint.
UPLOAD_SECRET=

# Canal WhatsApp: meta | simulator
WA_PROVIDER=simulator

# Meta Cloud API (no hardcodear secretos)
META_TEST_MODE=true
META_BOT_NUMBER=15550000000
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# Números E.164 verificados en el número de prueba, separados por coma
META_VERIFIED_NUMBERS=

# IA opcional (AI Gateway). Sin esto el bot igual anda con parsers fijos.
# También se usa para transcribir audios (STT) en WhatsApp y /asistente.
AI_GATEWAY_API_KEY=
# Plan B (Google AI Studio). Alcanza con una de las dos para NLU + audios.
GOOGLE_GENERATIVE_AI_API_KEY=
# Fallback STT gratis si Gemini falla/satura (console.groq.com → Whisper).
# También respaldo de voz del comprador en /{slug} (Groq primero; no pisa Gemini dueña).
GROQ_API_KEY=
